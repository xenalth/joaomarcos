---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="Contato" lang="pt">
  <div class="page-shell">
    <div class="contact-content">
      <h1>Contato</h1>
      <p>Se você quer conversar sobre produto, ética, ou está pensando em trabalhar junto: <a href="mailto:contato@joaomarcos.pro">contato@joaomarcos.pro</a></p>
      <p class="note">Respondo para conversas reais. Não respondo para solicitações de "networking" sem contexto ou propostas de conteúdo patrocinado.</p>
      <div class="links">
        <a href="https://linkedin.com/in/jmarcosferreira" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-content {
    max-width: var(--prose-width);
    margin: 0 auto;
    padding: var(--space-16) 0 var(--space-8);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-8);
  }
  p {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: var(--leading-prose);
    margin-bottom: 1.25em;
    color: var(--color-text);
  }
  a {
    color: var(--color-accent);
    border-bottom: 1px solid #B8D4C8;
  }
  a:hover { border-color: var(--color-accent); }
  .note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .links {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-6);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }
</style>
