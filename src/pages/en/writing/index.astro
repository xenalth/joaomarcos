---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import WritingList from '../../../components/writing/WritingList.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing-en', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    date: p.data.date,
    type: p.data.type,
  }));
---

<BaseLayout title="Writing" description="Essays and cases about product and ethics." lang="en">
  <div class="page-shell">
    <header class="writing-header">
      <h1>Writing</h1>
      <p>Essays and cases structured as arguments, not process documentation. The cases show judgment, not method.</p>
    </header>
    <WritingList items={posts} lang="en" />
  </div>
</BaseLayout>

<style>
  .writing-header {
    padding: var(--space-16) 0 var(--space-12);
    max-width: var(--prose-width);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  p {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    line-height: 1.65;
    max-width: 52ch;
    font-style: italic;
  }

  @media (max-width: 760px) {
    .writing-header {
      padding: var(--space-12) 0 var(--space-8);
    }
    h1 {
      font-size: clamp(1.5rem, 7vw, 2rem);
    }
  }
</style>
