---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPosts = await getCollection('writing-pt', ({ data }) => !data.draft);
const recent = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout title="João Marcos" lang="pt" description="Head de Produto · Pagamentos & Fintech. Produto tem muito mais poder sobre comportamento humano do que a gente admite.">
  <div class="page-shell">
    <section class="hero">
      <h1>Produto tem muito mais poder sobre o comportamento humano do que a gente admite.</h1>
      <p class="tagline">Head de Produto · Pagamentos & Fintech · São Paulo</p>
      <p>Mais de uma década em tech, os últimos sete em produto. Enquanto avança, algumas perguntas ficam para trás. Estas são as minhas.</p>
    </section>

    {recent.length > 0 && (
      <section class="recent">
        <div class="section-label">Escrita recente</div>
        <ul class="home-list">
          {recent.map((post) => (
            <li>
              <a href={`${base}/escrita/${post.id}`}>
                <span>{post.data.title}</span>
                <span class="item-meta">
                  <span class={`tag tag--${post.data.type}`}>
                    {post.data.type === 'essay' ? 'Ensaio' : 'Case'}
                  </span>
                  <time
                    datetime={post.data.date.toISOString().slice(0, 10)}
                    data-date={post.data.date.toISOString().slice(0, 10)}
                    data-date-format="short"
                  >{post.data.date.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href={`${base}/escrita`} class="see-all">Ver toda a escrita →</a>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-24) 0 var(--space-16);
    max-width: var(--prose-width);
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }
  .tagline {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    letter-spacing: 0.03em;
    margin-bottom: var(--space-6);
  }
  .hero p {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.7;
    max-width: 54ch;
  }

  .recent {
    padding-bottom: var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-12);
    max-width: 860px;
  }
  .section-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-6);
  }
  .home-list {
    list-style: none;
  }
  .home-list li {
    border-top: 1px solid var(--color-border);
    padding: var(--space-4) 0;
    transition: border-color 0.16s ease;
  }
  .home-list li:hover {
    border-color: #d5cfc9;
  }
  .home-list li:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .home-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-text);
    transition: color 0.15s ease, transform 0.16s ease;
  }
  .home-list a:hover {
    color: var(--color-accent);
    transform: translateX(2px);
  }
  .item-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .item-meta time {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }
  .see-all {
    display: inline-block;
    margin-top: var(--space-8);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration-color: currentColor;
    text-decoration-thickness: var(--link-underline-thickness);
    text-underline-offset: var(--link-underline-offset);
  }

  @media (max-width: 760px) {
    .hero {
      padding: var(--space-16) 0 var(--space-12);
    }
    h1 {
      font-size: clamp(1.55rem, 6.5vw, 2rem);
    }
    .recent {
      padding-top: var(--space-8);
    }
    .home-list a {
      display: block;
      line-height: 1.45;
    }
    .item-meta {
      margin-top: var(--space-2);
    }
  }
</style>
