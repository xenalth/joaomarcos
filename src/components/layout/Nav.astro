---
interface Props {
  lang: 'pt' | 'en';
  /** Current slug for lang switching on article pages. */
  slug?: string;
}

const { lang, slug } = Astro.props;

const links = {
  pt: { writing: '/escrita', about: '/sobre', contact: '/contato', writingLabel: 'Escrita', aboutLabel: 'Sobre', contactLabel: 'Contato', altLang: 'EN', altHref: slug ? `/en/writing/${slug}` : '/en' },
  en: { writing: '/en/writing', about: '/en/about', contact: '/en/contact', writingLabel: 'Writing', aboutLabel: 'About', contactLabel: 'Contact', altLang: 'PT', altHref: slug ? `/escrita/${slug}` : '/' },
};

const t = links[lang];
---

<nav>
  <div class="nav-inner page-shell">
    <a href={lang === 'pt' ? '/' : '/en'} class="nav-name">João Marcos</a>
    <ul class="nav-links">
      <li><a href={t.writing}>{t.writingLabel}</a></li>
      <li><a href={t.about}>{t.aboutLabel}</a></li>
      <li><a href={t.contact}>{t.contactLabel}</a></li>
      <li class="lang-switch"><a href={t.altHref}>{t.altLang}</a></li>
    </ul>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-name {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .nav-name:hover {
    color: var(--color-accent);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }
  .nav-links a {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.15s;
  }
  .nav-links a:hover {
    color: var(--color-text);
  }
  .lang-switch {
    border-left: 1px solid var(--color-border);
    padding-left: 2rem;
  }
</style>
