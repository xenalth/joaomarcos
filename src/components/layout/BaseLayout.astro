---
import Nav from './Nav.astro';
import '../../styles/global.css';
import '../../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  lang: 'pt' | 'en';
  slug?: string;
  ogType?: 'website' | 'article';
  publishedDate?: Date;
}

const { title, description, lang, slug, ogType = 'website', publishedDate } = Astro.props;
const siteName = 'João Marcos';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogDescription = description || (lang === 'pt'
  ? 'Pensamento em público sobre produto e ética.'
  : 'Thinking in public about product and ethics.');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const feedHref = lang === 'pt' ? `${base}/feed.xml` : `${base}/en/feed.xml`;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const shouldLoadAnalytics = import.meta.env.PROD && Boolean(gaMeasurementId);
const siteURL = new URL(base || '/', Astro.site).toString();
const locale = lang === 'pt' ? 'pt-BR' : 'en-US';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteName,
  url: siteURL,
  sameAs: ['https://linkedin.com/in/jmarcosferreira'],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteURL,
  inLanguage: locale,
  description: ogDescription,
};

const articleSchema = ogType === 'article' && publishedDate
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: ogDescription,
      datePublished: publishedDate.toISOString(),
      dateModified: publishedDate.toISOString(),
      inLanguage: locale,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
      author: {
        '@type': 'Person',
        name: siteName,
      },
      publisher: {
        '@type': 'Person',
        name: siteName,
      },
    }
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={ogDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:type" content={ogType} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={siteName} />}

    <!-- Twitter / LinkedIn -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogDescription} />

    <link rel="alternate" hreflang="pt" href={new URL(base || '/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}/en`, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — RSS`} href={feedHref} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="shortcut icon" href={`${base}/favicon.ico`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#F9F7F4" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>}

    {shouldLoadAnalytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
    <script is:inline>
      window.jmTrackEvent = function(name, params) {
        if (typeof window.gtag === 'function') {
          var baseParams = {
            page_path: window.location.pathname,
            page_lang: document.documentElement.lang || '',
          };
          window.gtag('event', name, Object.assign(baseParams, params || {}));
        }
      };
    </script>
  </head>
  <body>
    <Nav lang={lang} slug={slug} />
    <main>
      <slot />
    </main>
    <footer>
      <div class="page-shell footer-inner">
        <p>
          {lang === 'pt'
            ? 'João Marcos · Pensamento em público sobre produto e ética.'
            : 'João Marcos · Thinking in public about product and ethics.'}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1;
  }
  footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-8) 0;
    margin-top: var(--space-16);
  }
  .footer-inner {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
</style>
