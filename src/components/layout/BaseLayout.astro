---
import Nav from './Nav.astro';
import '../../styles/global.css';
import '../../styles/prose.css';

interface Props {
  title: string;
  description?: string;
  lang: 'pt' | 'en';
  slug?: string;
  ogType?: 'website' | 'article';
  publishedDate?: Date;
}

const { title, description, lang, slug, ogType = 'website', publishedDate } = Astro.props;
const siteName = 'João Marcos';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogDescription = description || (lang === 'pt'
  ? 'Pensamento em público sobre produto e ética.'
  : 'Thinking in public about product and ethics.');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const feedHref = lang === 'pt' ? `${base}/feed.xml` : `${base}/en/feed.xml`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={ogDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:type" content={ogType} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={siteName} />}

    <!-- Twitter / LinkedIn -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogDescription} />

    <link rel="alternate" hreflang="pt" href={new URL(base || '/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}/en`, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — RSS`} href={feedHref} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <Nav lang={lang} slug={slug} />
    <main>
      <slot />
    </main>
    <footer>
      <div class="page-shell footer-inner">
        <p>
          {lang === 'pt'
            ? 'Escrito por João Marcos. Sobre este site: pensamento em público sobre produto e ética.'
            : 'Written by João Marcos. About this site: thinking in public about product and ethics.'}
          <a href={feedHref} class="rss-link">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1;
  }
  footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-8) 0;
    margin-top: var(--space-16);
  }
  .footer-inner {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .rss-link {
    margin-left: var(--space-4);
    color: var(--color-accent);
    border-bottom: 1px solid #B8D4C8;
    padding-bottom: 1px;
  }
  .rss-link:hover {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }
</style>
